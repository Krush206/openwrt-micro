#!/bin/sh

# 0. Set up hostname
hostname OpenWrt.localhost

# 1. Mount essential pseudo-filesystems
mount -t proc none /proc
mount -t tmpfs none /tmp

# 2. Populate basic device nodes (needed for tiny standalone environments)
mount -t devpts none /dev/pts

# 3. Bring up the loopback interface
ifconfig lo 127.0.0.1 up

# 4. Configure eth0 with an IP address (adjust to match your subnet)
ifconfig eth0 192.168.1.1 netmask 255.255.255.0 up

# 5. Start the telnet daemon (BusyBox built-in)
telnetd -l /bin/sh
